# Реальный публичный адрес сайта, без завершающего /.
# NEXT_PUBLIC_SITE_URL=https://your-domain.ru
# Номер собственного счётчика Яндекс.Метрики. Пустое значение отключает сбор.
NEXT_PUBLIC_YANDEX_METRICA_ID=
# Код подтверждения из Яндекс.Вебмастера (meta yandex-verification).
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Оставьте пустым при размещении сайта и API на одном сервере.
NEXT_PUBLIC_LEADS_API_URL=
